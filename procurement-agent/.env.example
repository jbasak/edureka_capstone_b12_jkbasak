# ── Copy this file to .env and fill in real values ───────────────────────────

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# HuggingFace Embedding (runs locally, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval
TOP_K=6

# Qdrant (set to "qdrant" when running via docker-compose, "localhost" otherwise)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=procurement_docs

# Upload
MAX_UPLOAD_MB=25

# Logging
LOG_LEVEL=INFO

# App
APP_PORT=8000
